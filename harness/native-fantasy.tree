        <span .combat-companion at-feet 
          <img . 
      <div .combat-monster-art   pointer-events-none absolute right-0 top-9 z-0 flex h-[240px] w-[55%] items-end justify-e 
        <img .h-full w-full object-contain object-right-bottom 
      <div .combat-enemy-plaque relative z-10 mt-auto pb-1 ml-[25%] max-w-[75%] 
        <div .mb-1 flex items-center gap-2 
          <span .text-[11px] uppercase tracking-[.12em] text-[#c2b9a8] 
            "Ур. 2"
        <h1 .folio-title break-words text-xl font-bold leading-tight sm:text-2xl 
