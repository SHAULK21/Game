<main .shell-main flex-1 w-full mx-auto 
  <div .folio-page fantasy-combat-page classic-fantasy-surface space-y-3 pt-3 
    <section .bestiary-panel combat-hero-plaque grid grid-cols-[52px_minmax(0,1fr)] items-center gap-2.5 p-2 
      <div .relative h-[58px] w-[52px] overflow-hidden rounded-md border bg-[#0d1012] border-[#a98951] 
        <img .h-full w-full object-cover object-top 
      <div .min-w-0 
        <div .mb-1.5 flex items-center justify-between gap-2 
          <span .truncate text-xs font-semibold text-[#e1d5c0] 
            "Админ · Воин"
          <span .shrink-0 font-mono text-[11px] text-[#d2b676] 
            "Ур. 30"
        <span .combat-turn-label mb-1 block text-[11px] font-semibold text-[#d5ba89] role=status
          "Ваш ход — выберите действие"
        <div .mb-1.5 
          <div .mb-1 flex items-center justify-between gap-2 text-[11px] tabular-nums 
            <span .text-[#918c82] 
              "HP"
            <span .text-[#d8d1c4] 
              "900/900"
          <div .progress-track h-2 role=progressbar aria-label=HP
            <div .progress-fill is-hp 
        <div . 
          <div .mb-1 flex items-center justify-between gap-2 text-[11px] tabular-nums 
