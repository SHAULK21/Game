{
  "name": "react-example",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "start": "node --import tsx server/index.ts",
    "start:dev": "node --import tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "balance:pvp": "node --import tsx scripts/pvp-balance.ts",
    "balance:pve": "node --import tsx scripts/pve-balance.ts",
    "check:interfaces": "npm run build && node --experimental-vm-modules scripts/interface-production-check.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24",
    "pg": "^8.16.3",
    "helmet": "^8.1.0",
    "compression": "^1.8.1",
    "express-rate-limit": "^8.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21",
    "@types/compression": "^1.8.0",
    "@types/pg": "^8.15.5",
    "jsdom": "^30.1.1",
    "@types/jsdom": "^30.0.0",
    "@electric-sql/pglite": "^0.5.8"
  }
}
