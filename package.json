{
  "name": "react-example",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm:build": "node scripts/build-wasm.mjs",
    "wasm:test": "node --import tsx --test tests/typed-damage.test.ts tests/wasm-combat.test.ts",
    "perf:game": "node --import tsx scripts/profile-game.ts",
    "perf:wasm": "node --import tsx scripts/benchmark-wasm.ts",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && node scripts/build-game-engine.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "start": "node --import tsx server/index.ts",
    "start:dev": "node --import tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "balance:pvp": "node --import tsx scripts/pvp-balance.ts",
    "balance:pve": "node --import tsx scripts/pve-balance.ts",
    "check:interfaces": "npm run build && node --experimental-vm-modules scripts/interface-production-check.mjs",
    "balance:expeditions": "node --import tsx scripts/expedition-balance.ts",
    "pretest": "node scripts/build-game-engine.mjs --allow-source-assets",
    "serverless:audit": "node scripts/audit-native-release.mjs",
    "serverless:login": "tgcloud login",
    "build:native": "node scripts/build-native-engine.mjs",
    "build:telegram": "node scripts/build-telegram.mjs",
    "test:native": "node --import tsx --test --test-timeout=20000 tests/serverless-*.test.ts",
    "deploy": "npm run lint && npm run build:telegram && npm run test:native && npm run serverless:audit && tgcloud push"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.546.0",
    "pg": "^8.16.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "rolldown": "1.2.12",
    "tsx": "^4.21.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@noble/hashes": "2.0.1",
    "@tgcloud/cli": "^0.2.0",
    "@types/compression": "^1.8.0",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "jsdom": "^30.1.1",
    "libsodium-wrappers": "0.8.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
