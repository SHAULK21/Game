# Render production variables
NODE_ENV=production
NODE_VERSION=24.21.0
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true
TELEGRAM_BOT_TOKEN=123456:REPLACE_ME

# Telegram user ID allowed to see the admin panel (set only for the owner)
VITE_ADMIN_TELEGRAM_ID=

# Public URL for the Telegram webhook and game button
PUBLIC_BASE_URL=https://YOUR-SERVICE.onrender.com

# Server-side admin authorization (same Telegram ID as VITE_ADMIN_TELEGRAM_ID)
ADMIN_TELEGRAM_ID=

# Optional webhook secret; if empty, it is derived from the bot token
TELEGRAM_WEBHOOK_SECRET=

# Local development only. Never enable on a public deployment.
ALLOW_DEV_AUTH=false
